# --- Gemini API ---
# Google AI Studio で発行した APIキー。業務データを扱うため有料枠のキーを推奨。
# 空のままなら、システム管理者が画面の「AI設定」から登録できる（設定するとこちらが優先され、画面からは変更できない）。
GEMINI_API_KEY=
# 対話・日報生成のモデル
GEMINI_MODEL=gemini-3.5-flash
# 接続方法: gemini-api（① GEMINI_API_KEY で呼ぶ。既定）/ vertex（② Vertex AI。Google Cloud の認証で呼ぶ）
# 接続方法とモデルは役割（対話・文字起こし・読み上げ）ごとに、画面の「システム設定」でも変えられる（画面が優先）。
# 対話・日報作成（業務名の名寄せも同じ接続）の接続方法
# GEMINI_BACKEND=gemini-api
# ② Vertex AI のプロジェクトとリージョン（Cloud Text-to-Speech と共通）
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# 音声入力の文字起こしだけ別の接続方法・モデルにする場合（空なら対話と同じ）
# GEMINI_TRANSCRIPTION_BACKEND=
# GEMINI_TRANSCRIPTION_MODEL=
# 添付資料の解析に別のモデルを使う場合だけ指定する
# GEMINI_DOCUMENT_MODEL=
# thinking level（MINIMAL / LOW / MEDIUM / HIGH）
GEMINI_CHAT_THINKING_LEVEL=LOW
GEMINI_DOCUMENT_THINKING_LEVEL=HIGH
GEMINI_REQUEST_TIMEOUT_MS=120000
# 業務名の名寄せ（取得できなければ文字列一致で動作する）
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- 読み上げ ---
# 方式は画面の「システム設定」でも選べる（画面が優先）。Cloud Text-to-Speech の認証（ADC / Workload Identity 連携）は、
# 画面の「システム設定」→「② Vertex AI（Google Cloud）」で選ぶ（Vertex AI と共通）。
# 方式: gemini-tts（既定。① Gemini APIキーで呼ぶ）/ cloud-tts（② Google Cloud Text-to-Speech）
# cloud-tts は Google Cloud の認証情報（ADC）で呼ぶ。ローカルでは `gcloud auth application-default login`、
# コンテナではサービスアカウントの鍵を渡すか、GCE ではVMのサービスアカウントを使う。
# プロジェクトで Cloud Text-to-Speech API を有効にしておくこと。
# HINAMI_TTS_ENGINE=gemini-tts
# cloud-tts のモデルと基準の速さ（0.25〜2.0。利用者のペース設定はこれに掛け合わせる）
# CLOUD_TTS_MODEL=gemini-2.5-flash-tts
# CLOUD_TTS_SPEAKING_RATE=1.0
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Sulafat
# 話し方の指示。既定は指定なし（声の素の読み上げ）。調整したいときだけ短い言葉で足す。
# 長い指示はかえって声のトーンがぶれたり、音声が返らなかったりする。
# GEMINI_TTS_STYLE=warm and enthusiastic
# 読み上げのたびに声質が揺れないよう、生成の乱数を固定する（既定で固定。空にすると固定しない）
# GEMINI_TTS_SEED=20260929
# 読み上げの言語（既定 ja-JP）。空にするとモデルに推し量らせる
# GEMINI_TTS_LANGUAGE=ja-JP

# --- 認証（任意。未設定なら 127.0.0.1 でログインなしの開発モード） ---
GOOGLE_OAUTH_CLIENT_ID=
# ログイントークンの署名鍵。未設定なら初回起動時に生成し、データ保存先の auth/app_auth_secret に保存する。
# Cloud Run などファイルが残らない環境では必ず設定する（未設定だと起動しない）。
APP_AUTH_SECRET=
APP_AUTH_TOKEN_TTL_SECONDS=43200
# 最初にログインしたとき管理者にするメールアドレス（カンマ区切り）
HINAMI_BOOTSTRAP_ADMIN_EMAILS=
# ログインなしの開発モードで、ループバックに加えて受け付ける接続元IP（compose.yaml が設定する）
# HINAMI_LOCAL_CLIENT_HOSTS=

# --- 起動 ---
# `python -m backend` の待ち受け先（既定 127.0.0.1:8000）。
# ログインなしの開発モードは 127.0.0.1 でしか起動しない。コンテナでは設定しないこと。
# HINAMI_API_HOST=127.0.0.1
# HINAMI_API_PORT=8000
# prod / production にするとAPI仕様（/docs）を公開しない
APP_ENV=
# ブラウザから呼べるオリジン（開発サーバー用）
HINAMI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 公開ホスト名を固定する場合（カンマ区切り）
HINAMI_ALLOWED_HOSTS=
# リバースプロキシ配下でだけ true にする
HINAMI_TRUST_FORWARDED_FOR=

# --- 保存先（未設定なら backend/app/data 配下） ---
# HINAMI_DATA_DIR=/var/lib/hinami
# HINAMI_SQLITE_PATH=/var/lib/hinami/hinami.sqlite
# HINAMI_SQLITE_BACKUP_DIR=/var/lib/hinami/backups

# --- AIの利用制限（利用者ごと。0で無効） ---
HINAMI_AI_RATE_PER_MINUTE=12
HINAMI_AI_RATE_PER_DAY=300
HINAMI_AI_USAGE_RETENTION_DAYS=90
