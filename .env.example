# AIのAPIキー、接続方法、モデル、Vertex AI、Google連携は、ログイン後の
# 「システム設定」から設定します。

# --- AIの詳細調整（通常は変更不要） ---
# 添付資料の解析だけ別のモデルを使う場合
# GEMINI_DOCUMENT_MODEL=
# thinking level（MINIMAL / LOW / MEDIUM / HIGH）
GEMINI_CHAT_THINKING_LEVEL=LOW
GEMINI_DOCUMENT_THINKING_LEVEL=HIGH
GEMINI_REQUEST_TIMEOUT_MS=120000
# 業務名の名寄せ（取得できなければ文字列一致で動作する）
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 読み上げのたびに声質が揺れないよう、生成の乱数を固定する（既定で固定。空にすると固定しない）
# GEMINI_TTS_SEED=20260929
# 読み上げの言語（既定 ja-JP）。空にするとモデルに推し量らせる
# GEMINI_TTS_LANGUAGE=ja-JP

# --- 認証（任意。未設定なら 127.0.0.1 でログインなしの開発モード） ---
GOOGLE_OAUTH_CLIENT_ID=
# ログイントークンの署名鍵。未設定なら初回起動時に生成し、データ保存先の auth/app_auth_secret に保存する。
# Cloud Run などファイルが残らない環境では必ず設定する（未設定だと起動しない）。
APP_AUTH_SECRET=
APP_AUTH_TOKEN_TTL_SECONDS=43200
# 最初にログインしたとき管理者にするメールアドレス（カンマ区切り）
HINAMI_BOOTSTRAP_ADMIN_EMAILS=
# ログインなしの開発モードで、ループバックに加えて受け付ける接続元IP（compose.yaml が設定する）
# HINAMI_LOCAL_CLIENT_HOSTS=

# --- Docker Compose ---
HINAMI_COMPOSE_PORT=8080
# Dockerネットワークが既存のネットワークと重なる場合だけ変更する
# HINAMI_COMPOSE_SUBNET=172.29.90.0/24
# HINAMI_COMPOSE_GATEWAY=172.29.90.1

# --- 起動 ---
# `python -m backend` の待ち受け先（既定 127.0.0.1:8000）。
# ログインなしの開発モードは 127.0.0.1 でしか起動しない。コンテナでは設定しないこと。
# HINAMI_API_HOST=127.0.0.1
# HINAMI_API_PORT=8000
# prod / production にするとAPI仕様（/docs）を公開しない
APP_ENV=
# ブラウザから呼べるオリジン（開発サーバー用）
HINAMI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 公開ホスト名を固定する場合（カンマ区切り）
HINAMI_ALLOWED_HOSTS=
# リバースプロキシ配下でだけ true にする
HINAMI_TRUST_FORWARDED_FOR=

# --- 保存先（未設定なら backend/app/data 配下） ---
# HINAMI_DATA_DIR=/var/lib/hinami
# HINAMI_SQLITE_PATH=/var/lib/hinami/hinami.sqlite
# HINAMI_SQLITE_BACKUP_DIR=/var/lib/hinami/backups

# --- AIの利用制限（利用者ごと。0で無効） ---
HINAMI_AI_RATE_PER_MINUTE=12
HINAMI_AI_RATE_PER_DAY=300
HINAMI_AI_USAGE_RETENTION_DAYS=90
